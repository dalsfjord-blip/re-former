<h1>Registrer ny bruker (form_with)</h1>

<%= form_with model: @user do |f| %>

  <%# --- FEILMELDINGSBLOKK START --- %>
  <% if @user.errors.any? %>
    <div style="color: red; border: 1px solid red; padding: 10px; margin-bottom: 15px;">
      <h2><%= pluralize(@user.errors.count, "error") %> forhindret lagring:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%# --- FEILMELDINGSBLOKK SLUTT --- %>

  <div>
    <%= f.label :username, "Brukernavn" %>
    <%= f.text_field :username %>
  </div>

  <div>
    <%= f.label :email, "E-post" %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "Passord" %>
    <%= f.password_field :password %>
  </div>

  <%= f.submit %>
<% end %>

